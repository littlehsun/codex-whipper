# Copy to .env. Actual .env files must never be committed.
# Precedence: CLI options > process environment > .env > built-in defaults.
# Quote values containing spaces. No shell execution or $VARIABLE expansion.

# Codex home; blank database/socket values are derived from this directory.
WHIPPER_CODEX_HOME=~/.codex
WHIPPER_DATABASE=
WHIPPER_SOCKET=
# Blank uses ~/.local/state/codex-whipper/{state,dry-run}.json.
# If explicitly set, dry-run uses a sibling file instead of the live state.
WHIPPER_STATE=

# Comma-separated UUIDs. Empty THREADS watches all shared-server root sessions.
WHIPPER_THREADS=
# Explicit opt-in for each local standalone Codex CLI in Herdr. Empty disables it.
WHIPPER_HERDR_THREADS=
WHIPPER_HERDR_BIN=~/.local/bin/herdr

WHIPPER_MESSAGE="keep doing"
WHIPPER_DELAY=60
WHIPPER_MAX_DELAY=300
WHIPPER_MAX_RETRIES=5
WHIPPER_MAX_AGE=1800
WHIPPER_POLL=5
WHIPPER_LOOKBACK=1800
WHIPPER_RECONCILE_ON_START=true
# Start with inspection only. Set false when ready to send messages.
WHIPPER_DRY_RUN=true
WHIPPER_ONCE=false

# Relative paths are based on the project folder; blank logs go to stderr.
# The active log + one backup are capped at 1,000,000 bytes in total.
WHIPPER_LOG_FILE=logs/whipper.log

# Service installer overrides (optional). Blank uses this checkout and .venv.
WHIPPER_INSTALL_DIR=
WHIPPER_PYTHON=
